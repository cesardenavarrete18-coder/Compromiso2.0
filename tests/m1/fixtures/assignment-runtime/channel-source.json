  "query": "WITH selected AS (SELECT c.oid,c.relname,c.relowner,c.relacl,c.relrowsecurity,c.relforcerowsecurity FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname IN ('whatsapp_conversation_events','whatsapp_follow_up_reminders','lead_messages'))\nSELECT jsonb_build_object(\n'captured_at',clock_timestamp(),\n'tables',(SELECT jsonb_agg(jsonb_build_object('schema','public','name',relname,'owner',pg_get_userbyid(relowner),'acl',relacl::text,'rls_enabled',relrowsecurity,'rls_forced',relforcerowsecurity) ORDER BY relname) FROM selected),\n'columns',(SELECT jsonb_agg(jsonb_build_object('table',s.relname,'name',a.attname,'position',a.attnum,'type',format_type(a.atttypid,a.atttypmod),'not_null',a.attnotnull,'identity',a.attidentity,'generated',a.attgenerated,'default',pg_get_expr(d.adbin,d.adrelid)) ORDER BY s.relname,a.attnum) FROM selected s JOIN pg_attribute a ON a.attrelid=s.oid LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attnum>0 AND NOT a.attisdropped),\n'constraints',(SELECT jsonb_agg(jsonb_build_object('table',s.relname,'name',c.conname,'definition',pg_get_constraintdef(c.oid)) ORDER BY s.relname,c.conname) FROM selected s JOIN pg_constraint c ON c.conrelid=s.oid),\n'indexes',(SELECT jsonb_agg(jsonb_build_object('table',tablename,'name',indexname,'definition',indexdef) ORDER BY tablename,indexname) FROM pg_indexes WHERE schemaname='public' AND tablename IN(SELECT relname FROM selected)),\n'triggers',(SELECT jsonb_agg(jsonb_build_object('table',s.relname,'name',t.tgname,'definition',pg_get_triggerdef(t.oid),'enabled',t.tgenabled) ORDER BY s.relname,t.tgname) FROM selected s JOIN pg_trigger t ON t.tgrelid=s.oid WHERE NOT t.tgisinternal),\n'policies',(SELECT jsonb_agg(to_jsonb(p) ORDER BY p.tablename,p.policyname) FROM pg_policies p WHERE p.schemaname='public' AND p.tablename IN(SELECT relname FROM selected)),\n'grants',(SELECT jsonb_agg(jsonb_build_object('table',s.relname,'grantor',pg_get_userbyid(x.grantor),'grantee',CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(x.grantee) END,'privilege',x.privilege_type,'grantable',x.is_grantable) ORDER BY s.relname,x.grantee,x.privilege_type) FROM selected s CROSS JOIN LATERAL aclexplode(s.relacl)x),\n'sequences',(SELECT jsonb_agg(jsonb_build_object('name',c.relname,'owner',pg_get_userbyid(c.relowner),'acl',c.relacl::text,'type',format_type(s.seqtypid,null),'start',s.seqstart::text,'increment',s.seqincrement::text,'max',s.seqmax::text,'min',s.seqmin::text,'cache',s.seqcache::text,'cycle',s.seqcycle) ORDER BY c.relname) FROM pg_sequence s JOIN pg_class c ON c.oid=s.seqrelid WHERE c.oid IN(SELECT d.objid FROM pg_depend d JOIN selected t ON t.oid=d.refobjid WHERE d.classid='pg_class'::regclass AND d.refclassid='pg_class'::regclass AND d.deptype IN('a','i'))),\n'sequence_grants',(SELECT jsonb_agg(jsonb_build_object('sequence',c.relname,'grantor',pg_get_userbyid(x.grantor),'grantee',CASE WHEN x.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(x.grantee) END,'privilege',x.privilege_type,'grantable',x.is_grantable) ORDER BY c.relname,x.grantee,x.privilege_type) FROM pg_sequence s JOIN pg_class c ON c.oid=s.seqrelid CROSS JOIN LATERAL aclexplode(c.relacl)x WHERE c.oid IN(SELECT d.objid FROM pg_depend d JOIN selected t ON t.oid=d.refobjid WHERE d.classid='pg_class'::regclass AND d.refclassid='pg_class'::regclass AND d.deptype IN('a','i'))),\n'functions',(SELECT jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'arguments',pg_get_function_identity_arguments(p.oid),'definition',pg_get_functiondef(p.oid),'sha256',encode(sha256(convert_to(pg_get_functiondef(p.oid),'UTF8')),'hex'),'owner',pg_get_userbyid(p.proowner),'acl',p.proacl::text,'security_definer',p.prosecdef,'config',p.proconfig) ORDER BY n.nspname,p.proname) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE (n.nspname='public' AND p.proname='set_whatsapp_conversation_mode') OR p.oid IN(SELECT t.tgfoid FROM selected s JOIN pg_trigger t ON t.tgrelid=s.oid WHERE NOT t.tgisinternal))\n) AS snapshot",
