{
  "name": "grupo-sur-ai-eval-shadow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preflight:offline": "node --import tsx src/cli.mjs preflight --offline",
    "preflight:live": "node --import tsx src/cli.mjs preflight --live",
    "compile": "node --import tsx src/cli.mjs compile",
    "candidate:test": "node --import tsx --test test/candidate-v1.test.mjs",
    "candidate:v2:test": "node --import tsx --test test/candidate-v2.test.mjs test/candidate-v2-coverage-gaps.test.mjs",
    "candidate:demo:gsv1-001": "node --import tsx src/candidate-v1/demo-gsv1-001.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "run": "node --import tsx src/cli.mjs run --execute",
    "candidate:v2.1:test": "node --import tsx --test test/candidate-v2.1*.test.mjs",
    "candidate:v2.2:test": "node --import tsx --test test/candidate-v2.2*.test.mjs",
    "candidate:v2.3:test": "node --import tsx --test test/candidate-v2.3*.test.mjs",
    "filter:v1:test": "node --import tsx --test test/filter-v1.test.mjs test/filter-v1-integration.test.mjs test/filter-v1-semantic-extraction.test.mjs",
    "filter:v1:integration:test": "node --import tsx --test test/filter-v1-integration.test.mjs",
    "filter:v1:semantic:test": "node --import tsx --test test/filter-v1-semantic-extraction.test.mjs",
    "filter:v1:semantic:online:test": "node --import tsx --test test/filter-v1-semantic-online-harness.test.mjs"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
