{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filter-v1-semantic-extractor/1.0",
  "title": "Filter v1 semantic extraction proposal",
  "type": "object",
  "required": ["schema_version", "query_intent", "purchase_mode_statement", "amount_mentions", "vehicle_mentions", "trade_in_intent", "human_request", "strong_action", "do_not_contact", "customer_corrections", "needs_clarification", "evidence"],
  "properties": {
    "schema_version": {"const": "filter-v1-semantic-extractor/1.0"},
    "query_intent": {"enum": ["model_value", "installment_offer", "delivery_advance", "subscription_amount", "ambiguous_initial_amount", "technical_question", "general_information", "none"]},
    "purchase_mode_statement": {"enum": ["cash", "financed", "not_present", "conflicting"]},
    "purchase_mode_literal": {"type": ["string", "null"]},
    "amount_mentions": {"type": "array", "items": {"$ref": "#/$defs/amount"}},
    "vehicle_mentions": {"type": "array", "items": {"$ref": "#/$defs/vehicle"}},
    "trade_in_intent": {"enum": ["yes", "no", "not_present", "ambiguous"]},
    "trade_in_vehicle": {"type": ["object", "null"]},
    "customer_name": {"type": ["object", "null"]},
    "customer_location": {"type": ["object", "null"]},
    "human_request": {"type": "boolean"},
    "strong_action": {"type": "boolean"},
    "requested_action": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]},
    "contact_preference_expression": {"type": ["object", "null"]},
    "do_not_contact": {"type": "boolean"},
    "customer_corrections": {"type": "array", "items": {"type": "object"}},
    "needs_clarification": {"type": "array", "items": {"type": "object", "required": ["code", "evidence"], "properties": {"code": {"enum": ["amount_scale_or_currency", "initial_amount_intent", "multiple_target_models", "cross_brand_target", "vehicle_role", "conflicting_purchase_mode", "other"]}, "evidence": {"$ref": "#/$defs/evidenceOrList"}}}},
    "evidence": {"type": "object"}
  },
  "$defs": {
    "certainty": {"enum": ["explicit", "contextual", "ambiguous"]},
    "evidence": {"type": "object", "required": ["message_id", "text"], "properties": {"message_id": {"type": "string"}, "text": {"type": "string"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "evidenceOrList": {"oneOf": [{"$ref": "#/$defs/evidence"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}]},
    "amount": {"type": "object", "required": ["kind", "numeric_value", "currency", "literal", "certainty", "confirmation_recommended", "evidence"], "properties": {"kind": {"enum": ["down_payment_capacity", "monthly_installment_capacity", "trade_in_customer_estimate", "unknown_amount"]}, "numeric_value": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"]}, "literal": {"type": "string"}, "certainty": {"$ref": "#/$defs/certainty"}, "confirmation_recommended": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/evidenceOrList"}}, "additionalProperties": false},
    "vehicle": {"type": "object", "required": ["literal", "role", "certainty", "evidence"], "properties": {"literal": {"type": "string"}, "brand_text": {"type": ["string", "null"]}, "model_text": {"type": ["string", "null"]}, "version_text": {"type": ["string", "null"]}, "role": {"enum": ["target", "target_candidate", "comparison", "owned_only", "trade_in", "unknown"]}, "certainty": {"$ref": "#/$defs/certainty"}, "evidence": {"$ref": "#/$defs/evidenceOrList"}}, "additionalProperties": false},
    "action": {"type": "object", "required": ["type", "certainty", "evidence"], "properties": {"type": {"enum": ["visit", "deposit", "transfer", "documents", "advance_purchase", "other"]}, "time_expression": {"type": ["string", "null"]}, "certainty": {"$ref": "#/$defs/certainty"}, "evidence": {"$ref": "#/$defs/evidenceOrList"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
