  "query_provenance": {
    "runtime_aggregate": "SELECT clock_timestamp() AS observed_at,\n(SELECT coalesce(jsonb_agg(jsonb_build_object('jobid',jobid,'jobname',jobname,'schedule',schedule,'active',active,'references_reminder_endpoint',position('whatsapp-follow-up-reminders' in command)>0,'references_pg_net',position('net.http_post' in command)>0) ORDER BY jobid),'[]'::jsonb) FROM cron.job) AS jobs,\n(SELECT coalesce(jsonb_agg(to_jsonb(s)),'[]'::jsonb) FROM (SELECT jobid,status,count(*) AS runs,min(start_time) AS first_start,max(start_time) AS last_start,count(*) FILTER (WHERE end_time IS NULL) AS no_end_recorded FROM cron.job_run_details WHERE start_time>=now()-interval '24 hours' GROUP BY jobid,status ORDER BY jobid,status) s) AS cron_runs_last_24h,\n(SELECT count(*) FROM net.http_request_queue) AS pg_net_queued_requests,\n(SELECT coalesce(jsonb_agg(to_jsonb(s)),'[]'::jsonb) FROM (SELECT status_code,timed_out,count(*) AS responses,min(created) AS first_recorded,max(created) AS last_recorded FROM net._http_response WHERE created>=now()-interval '24 hours' GROUP BY status_code,timed_out ORDER BY status_code,timed_out) s) AS pg_net_responses_last_24h,\n(SELECT coalesce(jsonb_agg(to_jsonb(s)),'[]'::jsonb) FROM (SELECT status,count(*) AS rows,count(*) FILTER(WHERE due_at<=now()) AS due_rows,min(due_at) AS earliest_due,max(claimed_at) AS latest_claim,max(sent_at) AS latest_sent FROM public.whatsapp_follow_up_reminders GROUP BY status ORDER BY status) s) AS reminder_state_aggregate,\n(SELECT coalesce(jsonb_agg(jsonb_build_object('updated_at',updated_at,'qualification_rules_md5',md5(qualification_rules),'qualification_rules_chars',length(qualification_rules),'conversation_style_md5',md5(conversation_style),'conversation_style_chars',length(conversation_style),'vector_store_configured',nullif(vector_store_id,'') IS NOT NULL)),'[]'::jsonb) FROM public.ai_assistant_settings) AS ai_settings_fingerprints,\n(SELECT coalesce(jsonb_agg(jsonb_build_object('role',rolname,'can_login',rolcanlogin,'bypass_rls',rolbypassrls,'superuser',rolsuper)),'[]'::jsonb) FROM pg_roles WHERE rolname IN ('service_role','crm_ingress_worker','crm_processing_worker','crm_dispatch_worker','crm_runtime_owner','crm_runtime_operator')) AS runtime_roles,\n(SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='private' AND c.relname LIKE 'crm_%' AND c.relkind IN ('r','p')) AS proposed_private_crm_table_count",
