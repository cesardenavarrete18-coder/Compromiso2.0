{
  "redirects": [
    {
      "source": "/vendedores/supervisor/:path*",
      "destination": "/supervisores/:path*",
      "permanent": true
    },
    {
      "source": "/vendedores/admin/:path*",
      "destination": "/administracion/:path*",
      "permanent": true
    },
    {
      "source": "/vendedores/admventas/:path*",
      "destination": "/admventas/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/supervisores",
      "destination": "/vendedores/supervisor/index.html"
    },
    {
      "source": "/supervisores/:path*",
      "destination": "/vendedores/supervisor/:path*"
    },
    {
      "source": "/administracion",
      "destination": "/vendedores/admin/index.html"
    },
    {
      "source": "/administracion/:path*",
      "destination": "/vendedores/admin/:path*"
    },
    {
      "source": "/admventas",
      "destination": "/vendedores/admventas/index.html"
    },
    {
      "source": "/admventas/:path*",
      "destination": "/vendedores/admventas/:path*"
    }
  ]
}
